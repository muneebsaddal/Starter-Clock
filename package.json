{
  "name": "starter-clock",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.thresholds.statements=80 --coverage.thresholds.branches=80",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-image-picker": "~56.0.18",
    "expo-linking": "~56.0.14",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-iap": "^15.3.2",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/react-native": "14.0.0",
    "@types/node": "22.19.15",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~56.0.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vitest": "4.1.9"
  }
}
